<mujoco model="rover2025_gripper_model">
    <default>
        <joint limited="false" damping="5.0" armature="0.1" frictionloss="0.1" />
        <geom condim="4" contype="1" conaffinity="1" />
        
        <default class="prismatic">
            <joint type="slide" limited="true" armature="0.05" damping="20" frictionloss="1.0" />
        </default>
        
        <default class="collision">
            <geom group="0" rgba="0.7 0.7 0.7 1" type="mesh" />
        </default>
        
        <default class="visual">
            <geom group="1" material="default_material" type="mesh" />
        </default>
    </default>

    <compiler angle="radian" eulerseq="xyz" />

    <asset>
        <material name="default_visual" rgba="0.7 0.7 0.7 1" />
        <material name="default_material" rgba="0.7 0.7 0.7 1" />
        <mesh name="base_ee" file="meshes/rover2025_gripper/Base-EE.stl" />
        <mesh name="gripper1" file="meshes/rover2025_gripper/Gripper-1.stl" />
        <mesh name="gripper2" file="meshes/rover2025_gripper/Gripper-2.stl" />
    </asset>

    <tendon>
        <fixed name="gripper_coupling">
            <joint joint="gripper1_joint" coef="1" />
            <joint joint="gripper2_joint" coef="-1" />
        </fixed>
    </tendon>

    <actuator>
        <position name="gripper_actuator1" joint="gripper1_joint" kp="400" kv="10" ctrlrange="-1 1" forcerange="-5 5"/>
        <position name="gripper_actuator2" joint="gripper2_joint" kp="400" kv="10" ctrlrange="-1 1" forcerange="-5 5"/>
    </actuator>

    <worldbody>
        <body name="base_ee" pos="0 0 0" euler="0 0 0">
            <site name="ft_frame" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere" group="1" />
            
            <body name="eef" pos="0 0 0.145" quat="0.707105 0 0 -0.707105">
                <site name="grip_site" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 0.5" type="sphere" group="1" />
                <site name="ee_x" pos="0.1 0 0" size="0.005 .1" quat="0.707105 0 0.707108 0" rgba="1 0 0 0" type="cylinder" group="1" />
                <site name="ee_y" pos="0 0.1 0" size="0.005 .1" quat="0.707105 0.707108 0 0" rgba="0 1 0 0" type="cylinder" group="1" />
                <site name="ee_z" pos="0 0 0.1" size="0.005 .1" quat="1 0 0 0" rgba="0 0 1 0" type="cylinder" group="1" />
                <site name="grip_site_cylinder" pos="0 0 0" size="0.005 10" rgba="0 1 0 0.3" type="cylinder" group="1" />
            </body>

            <geom class="collision" mesh="base_ee" />
            <geom class="visual" mesh="base_ee" />
            
            <inertial
                pos="-0.001 0.0004 -0.04"
                mass="0.3"
                diaginertia="0.001 0.001 0.001"
            />

            <body name="gripper1" pos="0 0 0" quat="1 0 0 0">
                <joint name="gripper1_joint" class="prismatic" axis="0 -1 0" range="-0.1 0.1" damping="10" armature="0.5"/>
                
                <geom name="left_fingerpad" class="collision" type="box" size="0.005 0.01 0.02" pos="0 -0.095 0.1"/>

                <geom class="visual" mesh="gripper1" conaffinity="0" contype="0"/>
                
                <inertial
                    pos="0.01 -0.04 0.08"
                    mass="0.1"
                    diaginertia="0.0001 0.0001 0.0001"
                />
            </body>

            <body name="gripper2" pos="0 0 0" quat="1 0 0 0">
                <joint name="gripper2_joint" class="prismatic" axis="0 1 0" range="-0.1 0.1" damping="10" armature="0.5" />
                
                <geom name="right_fingerpad" class="collision" type="box" size="0.005 0.01 0.02" pos="0 0.095 0.1"/>

                <geom class="visual" mesh="gripper2" conaffinity="0" contype="0"/>
                
                <inertial
                    pos="0.01 -0.04 0.08"
                    mass="0.1"
                    diaginertia="0.0001 0.0001 0.0001"
                />
            </body>
        </body>
    </worldbody>

    <sensor>
        <force name="force_ee" site="ft_frame" />
        <torque name="torque_ee" site="ft_frame" />
    </sensor>
</mujoco>