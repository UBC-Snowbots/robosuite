<mujoco model="stick_model">
    <default>
        <joint limited="false" damping="5.0" armature="0.1" frictionloss="0.1" />
        <geom condim="4" contype="1" conaffinity="1" />

        <default class="collision">
            <geom group="0" rgba="0.4 0.4 0.4 1" />
        </default>

        <default class="visual">
            <geom group="1" conaffinity="0" contype="0" />
        </default>
    </default>

    <compiler angle="radian" eulerseq="xyz" />

    <asset>
        <material name="stick_material" rgba="0.3 0.3 0.3 1" />
        <material name="tip_material" rgba="0.9 0.2 0.2 1" />
    </asset>

    <worldbody>
        <body name="base_ee" pos="0 0 0" euler="0 0 0">
            <site name="ft_frame" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere" group="1" />

            <body name="eef" pos="0 0 0.145" quat="0.707105 0 0 -0.707105">
                <site name="grip_site" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 0.5" type="sphere" group="1" />
                <site name="ee_x" pos="0.1 0 0" size="0.005 .1" quat="0.707105 0 0.707108 0" rgba="1 0 0 0" type="cylinder" group="1" />
                <site name="ee_y" pos="0 0.1 0" size="0.005 .1" quat="0.707105 0.707108 0 0" rgba="0 1 0 0" type="cylinder" group="1" />
                <site name="ee_z" pos="0 0 0.1" size="0.005 .1" quat="1 0 0 0" rgba="0 0 1 0" type="cylinder" group="1" />
                <site name="grip_site_cylinder" pos="0 0 0" size="0.005 10" rgba="0 1 0 0.3" type="cylinder" group="1" />
            </body>

            <!-- Mounting base (small cylinder at the ee attachment point) -->
            <geom class="collision" type="cylinder" size="0.015 0.01" pos="0 0 0.005" material="stick_material" />
            <geom class="visual" type="cylinder" size="0.015 0.01" pos="0 0 0.005" material="stick_material" />

            <!-- Stick shaft -->
            <geom class="collision" type="cylinder" size="0.005 0.06" pos="0 0 0.075" material="stick_material" />
            <geom class="visual" type="cylinder" size="0.005 0.06" pos="0 0 0.075" material="stick_material" />

            <!-- Small spherical tip for button pressing -->
            <geom name="stick_tip" class="collision" type="sphere" size="0.004" pos="0 0 0.14" material="tip_material" />
            <geom class="visual" type="sphere" size="0.004" pos="0 0 0.14" material="tip_material" />

            <inertial
                pos="0 0 0.07"
                mass="0.05"
                diaginertia="0.0001 0.0001 0.00005"
            />
        </body>
    </worldbody>

    <sensor>
        <force name="force_ee" site="ft_frame" />
        <torque name="torque_ee" site="ft_frame" />
    </sensor>
</mujoco>
